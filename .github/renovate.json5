{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>joshyorko/renovate-config:org-inherited-config"
  ],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "(?<justName>.+?)\\s:=\\s(?:env\\(.+?,\\s)?[\"'](?<packageName>\\S+?):(?<currentValue>\\S+?)@(?<currentDigest>sha256:[a-f0-9]+?)[\"']\\)?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "export bib_image := env\\(\"BIB_IMAGE\", \"(?<depName>quay\\.io/centos-bootc/bootc-image-builder):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\"\\)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Containerfile$/", "/^Containerfile\\.dakota$/"],
      "matchStrings": [
        "ARG BASE_IMAGE_REF=\"(?<depName>ghcr\\.io\\/projectbluefin\\/bluefin):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Containerfile\\.dakota$/"],
      "matchStrings": [
        "ARG BASE_IMAGE_REF=\"(?<depName>ghcr\\.io\\/projectbluefin\\/dakota):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-dakota\\.yml$/"],
      "matchStrings": [
        "base_image_ref:\\s*\"(?<depName>ghcr\\.io\\/projectbluefin\\/dakota(?:-nvidia)?):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-nvidia\\.yml$/"],
      "matchStrings": [
        "NVIDIA_BASE_IMAGE_REF:\\s*\"(?<depName>ghcr\\.io\\/projectbluefin\\/bluefin-nvidia):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "groupName": "Universal Blue dependencies",
      "matchPackageNames": [
        "/^ghcr\\.io\\/ublue-os\\//",
        "/^ghcr\\.io\\/projectbluefin\\//"
      ]
    },
    {
      "groupName": "bootc builder image",
      "matchPackageNames": ["quay.io/centos-bootc/bootc-image-builder"]
    }
  ]
}
