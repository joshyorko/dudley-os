ARG BASE_IMAGE_REF="ghcr.io/projectbluefin/dakota:stable@sha256:3848692f96d93ce88fedc3a90fccc8c216167c020ec08d751897f3dccbab86b6"
ARG CHROME_BUILDER_REF="registry.fedoraproject.org/fedora:46@sha256:8776f2d93f0e80262b0c19fc130fe1a60e71ee00e05ae174600c4f1205ba698b"
ARG DOCKER_BIN_REF="docker.io/library/docker:29-dind@sha256:5efed980cba3fc126cf54e21a5a6ff8849d05b6e0623d6e7612f48e9cd6cd17e"

FROM ${CHROME_BUILDER_REF} AS google-chrome
RUN dnf install -y cpio curl rpm xdg-utils && \
    curl -fsSL -o /tmp/google-linux-signing-key.pub \
        https://dl.google.com/linux/linux_signing_key.pub && \
    curl -fsSL -o /tmp/google-chrome.rpm \
        https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm && \
    rpmkeys --import /tmp/google-linux-signing-key.pub && \
    rpmkeys --checksig /tmp/google-chrome.rpm && \
    install -d -m 0755 /chrome-root && \
    cd /chrome-root && \
    rpm2cpio /tmp/google-chrome.rpm | cpio -idm --quiet && \
    install -D -m 0755 /usr/bin/xdg-desktop-menu /chrome-root/usr/bin/xdg-desktop-menu && \
    install -D -m 0755 /usr/bin/xdg-icon-resource /chrome-root/usr/bin/xdg-icon-resource && \
    install -D -m 0755 /usr/bin/xdg-mime /chrome-root/usr/bin/xdg-mime && \
    install -D -m 0755 /usr/bin/xdg-settings /chrome-root/usr/bin/xdg-settings && \
    test -x /chrome-root/opt/google/chrome/google-chrome && \
    rm -f /tmp/google-linux-signing-key.pub /tmp/google-chrome.rpm

FROM ${DOCKER_BIN_REF} AS docker-bin

FROM scratch AS ctx
COPY build/10-dakota.sh /build/10-dakota.sh
COPY build/18-parity-acceptance.sh /build/18-parity-acceptance.sh
COPY build/install-dakota-chrome.sh /build/install-dakota-chrome.sh
COPY build/install-dakota-docker.sh /build/install-dakota-docker.sh
COPY build/install-dakota-hooks.sh /build/install-dakota-hooks.sh
COPY build/install-dakota-just.sh /build/install-dakota-just.sh
COPY build/20-final-metadata.sh /build/20-final-metadata.sh
COPY contract/dudley-runtime.v1.json /contract/dudley-runtime.v1.json
COPY custom/ujust /custom/ujust
COPY custom/dakota /custom/dakota
COPY custom/system_files/etc/fonts/conf.d/60-dudley-monospace.conf /custom/system_files/etc/fonts/conf.d/60-dudley-monospace.conf
COPY custom/system_files/usr/share/glib-2.0/schemas/zz1-dudley-terminal.gschema.override /custom/system_files/usr/share/glib-2.0/schemas/zz1-dudley-terminal.gschema.override
COPY custom/system_files/usr/share/ublue-os/user-setup.hooks.d/10-wallpaper-enforcement.sh /custom/system_files/usr/share/ublue-os/user-setup.hooks.d/10-wallpaper-enforcement.sh
COPY --from=ghcr.io/joshyorko/dsb-common:latest@sha256:3cbc42def93dc989529d197df03c77406111610fa87bfa936b6d348dd8c58c5c /system_files/shared /oci/dsb-common/system_files/shared
COPY --from=ghcr.io/joshyorko/dsb-common:latest@sha256:3cbc42def93dc989529d197df03c77406111610fa87bfa936b6d348dd8c58c5c /system_files/dudley /oci/dsb-common/system_files/dudley
COPY --from=ghcr.io/joshyorko/dsb-common:latest@sha256:3cbc42def93dc989529d197df03c77406111610fa87bfa936b6d348dd8c58c5c /contract/dudley-payload.v1.json /oci/dsb-common/contract/dudley-payload.v1.json
COPY --from=ghcr.io/joshyorko/dsb-common:latest@sha256:3cbc42def93dc989529d197df03c77406111610fa87bfa936b6d348dd8c58c5c /scripts/install-payload.py /oci/dsb-common/scripts/install-payload.py
COPY --from=google-chrome /chrome-root /oci/google-chrome
COPY --from=docker-bin /usr/local/bin /oci/docker/usr/local/bin
COPY --from=docker-bin /usr/local/libexec/docker/cli-plugins /oci/docker/usr/local/libexec/docker/cli-plugins

FROM ${BASE_IMAGE_REF}
ARG BASE_IMAGE_REF
ARG FINAL_IMAGE_REF="ghcr.io/joshyorko/dudley-os:dakota"
ARG SHA_HEAD_SHORT="unknown"
ARG VSCODE_REFRESH_TOKEN

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build/10-dakota.sh

RUN --mount=type=tmpfs,dst=/tmp \
    google-chrome --version && \
    ! ldd /opt/google/chrome/chrome | grep -F 'not found' && \
    chrome_profile="$(mktemp -d)" && \
    google-chrome \
        --headless=new \
        --no-sandbox \
        --disable-gpu \
        --disable-dev-shm-usage \
        --no-first-run \
        --user-data-dir="${chrome_profile}" \
        about:blank \
        --dump-dom 2>/dev/null | grep -F '<html'

RUN bootc container lint
