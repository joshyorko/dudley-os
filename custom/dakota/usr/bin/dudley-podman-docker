#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
docker_host="unix://${runtime_dir}/podman/podman.sock"
environment_dir="${HOME}/.config/environment.d"

install -d -m 0755 "${environment_dir}"
printf 'DOCKER_HOST=%s\n' "${docker_host}" > \
    "${environment_dir}/60-dudley-podman-docker.conf"

systemctl --user enable --now podman.socket
systemctl --user set-environment "DOCKER_HOST=${docker_host}"

echo "Docker-compatible Podman API: ${docker_host}"
